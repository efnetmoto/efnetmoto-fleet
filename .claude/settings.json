{
  "permissions": {
    "allow": [
      "Bash(tclint:*)",
      "Bash(tclfmt:*)",
      "Bash(yamllint:*)",
      "Bash(ansible-lint:*)",
      "Bash(ansible-playbook --check:*)",
      "Bash(ansible-playbook --syntax-check:*)",
      "Bash(shellcheck:*)",
      "Bash(markdownlint:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tcl-check.sh"
          }
        ]
      }
    ]
  }
}
